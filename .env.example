# Compose host bindings. Every published port binds only to 127.0.0.1.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
RECEIVER_HOST_PORT=9000

# Local-development database bootstrap values. Replace the password in your
# untracked .env; production secrets must come from a secrets manager.
POSTGRES_DB=hookrelay
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=change-me-for-local-development

# HookRelay process settings used by Compose.
HOOKRELAY_LOG_LEVEL=INFO
HOOKRELAY_DATABASE_POOL_SIZE=5
HOOKRELAY_DATABASE_MAX_OVERFLOW=10
HOOKRELAY_READINESS_TIMEOUT_SECONDS=2

# Local-only bootstrap and encryption values. Generate unique secrets before
# using any non-local environment; the application rejects this AES key in
# staging and production.
HOOKRELAY_SECRET_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
HOOKRELAY_SECRET_ENCRYPTION_KEY_VERSION=1
HOOKRELAY_BOOTSTRAP_ENABLED=true
HOOKRELAY_BOOTSTRAP_TOKEN=replace-this-local-bootstrap-token-before-use

# Stage 3/4 durable pipeline settings. NATS stores only versioned ID envelopes;
# PostgreSQL remains authoritative for event bodies, URLs, and signing secrets.
HOOKRELAY_NATS_STREAM_NAME=HOOKRELAY_DELIVERIES_V1
HOOKRELAY_NATS_SUBJECT=hookrelay.delivery.requested.v1
HOOKRELAY_NATS_CONSUMER_NAME=HOOKRELAY_DELIVERY_WORKERS_V1
HOOKRELAY_NATS_CONNECT_TIMEOUT_SECONDS=2
HOOKRELAY_NATS_DRAIN_TIMEOUT_SECONDS=5
HOOKRELAY_NATS_PUBLISH_TIMEOUT_SECONDS=2
HOOKRELAY_NATS_DUPLICATE_WINDOW_SECONDS=600
HOOKRELAY_NATS_STREAM_MAX_BYTES=1073741824
HOOKRELAY_NATS_ACK_WAIT_SECONDS=30
HOOKRELAY_NATS_ACK_TIMEOUT_SECONDS=2
HOOKRELAY_NATS_MAX_ACK_PENDING=32
HOOKRELAY_OUTBOX_BATCH_SIZE=25
HOOKRELAY_OUTBOX_POLL_INTERVAL_SECONDS=0.25
HOOKRELAY_OUTBOX_CLAIM_TTL_SECONDS=60
HOOKRELAY_DELIVERY_WORKER_CONCURRENCY=8
HOOKRELAY_DELIVERY_FETCH_TIMEOUT_SECONDS=1
HOOKRELAY_DELIVERY_HTTP_TIMEOUT_SECONDS=10
HOOKRELAY_DELIVERY_CLAIM_TTL_SECONDS=20
HOOKRELAY_DELIVERY_FINALIZATION_MARGIN_SECONDS=5
HOOKRELAY_DELIVERY_MAX_ATTEMPTS=5
HOOKRELAY_DELIVERY_RETRY_BASE_SECONDS=1
HOOKRELAY_DELIVERY_RETRY_MAX_SECONDS=60
HOOKRELAY_DELIVERY_RETRY_JITTER_RATIO=0.25
HOOKRELAY_DELIVERY_POLICY_BLOCK_DELAY_SECONDS=30

# This allowlist is a deliberate local/test gate, not complete SSRF protection.
# Workers refuse to start in staging/production until Stage 5.
HOOKRELAY_DELIVERY_ALLOWED_HOSTS=["receiver","127.0.0.1","localhost"]

# Behavior of the local inspection receiver; never deploy it as a real endpoint.
HOOKRELAY_RECEIVER_RESPONSE_STATUS_CODE=204
HOOKRELAY_RECEIVER_DELAY_SECONDS=0
HOOKRELAY_RECEIVER_MAX_CAPTURED_REQUESTS=1000
