# Compose host bindings. Both services bind only to 127.0.0.1.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# Local-development database bootstrap values. Replace the password in your
# untracked .env; production secrets must come from a secrets manager.
POSTGRES_DB=hookrelay
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=change-me-for-local-development

# HookRelay process settings used by Compose.
HOOKRELAY_LOG_LEVEL=INFO
HOOKRELAY_DATABASE_POOL_SIZE=5
HOOKRELAY_DATABASE_MAX_OVERFLOW=10
HOOKRELAY_READINESS_TIMEOUT_SECONDS=2

# Local-only bootstrap and encryption values. Generate unique secrets before
# using any non-local environment; the application rejects this AES key in
# staging and production.
HOOKRELAY_SECRET_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
HOOKRELAY_SECRET_ENCRYPTION_KEY_VERSION=1
HOOKRELAY_BOOTSTRAP_ENABLED=true
HOOKRELAY_BOOTSTRAP_TOKEN=replace-this-local-bootstrap-token-before-use
